{
  "name": "@zdrofibot/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "pnpm --filter @zdrofibot/scheduling run build && drizzle-kit generate"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts"
    }
  },
  "dependencies": {
    "@zdrofibot/scheduling": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
