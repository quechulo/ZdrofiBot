# Copy to .env (gitignored) and fill in. The workers and the CLI read it.

# Local Postgres from compose.dev.yaml. In production, Neon's direct endpoint, not the pooler.
DATABASE_URL=postgres://zdrofibot:zdrofibot@127.0.0.1:54320/zdrofibot

# Development master key for secrets, 32 bytes in base64. Production uses KMS.
# node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SECRETS_LOCAL_KEK=

# From @BotFather. Leave empty and alerts are only logged.
TELEGRAM_BOT_TOKEN=

# Optional
# ZDROFIT_BASE_URL=https://zdrofit.pl
# DISCOVERY_CLUBS=another-club-slug
# WORKER_ID=fire-local
